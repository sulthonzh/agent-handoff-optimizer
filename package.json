{
  "name": "agent-handoff-optimizer",
  "version": "1.0.0",
  "description": "A specialized tool for optimizing and debugging agent handoffs in multi-agent systems",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aho": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs",
    "dev": "tsup src/index.ts src/cli.ts --format cjs --watch",
    "test": "node test.mjs",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "handoff",
    "optimization",
    "multi-agent",
    "performance",
    "debugging",
    "ai-agents",
    "coordination"
  ],
  "author": "Sulthonzh",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "tsup": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sulthonzh/agent-handoff-optimizer.git"
  },
  "homepage": "https://github.com/sulthonzh/agent-handoff-optimizer#readme",
  "bugs": {
    "url": "https://github.com/sulthonzh/agent-handoff-optimizer/issues"
  }
}
